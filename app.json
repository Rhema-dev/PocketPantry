{
  "expo": {
    "name": "PantryPilot",
    "slug": "pantrypilot",
    "scheme": "pantrypilot",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "icon": "./assets/icon-v2.png",
    "splash": {
      "image": "./assets/splash-v2.png",
      "resizeMode": "contain",
      "backgroundColor": "#0B4A32"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.madebykhua.pantrypilot"
    },
    "android": {
      "package": "com.madebykhua.pantrypilot",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon-v2.png",
        "backgroundColor": "#0B4A32"
      },
      "edgeToEdgeEnabled": true
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": ["expo-router"],
    "experiments": {
      "typedRoutes": true
    }
  }
}
